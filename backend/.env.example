# Copy to .env and fill in what you have. Everything is optional in dev.

# "development" (default) or "production". Production enables secure cookies
# and refuses to start without a real JWT_SECRET.
# APP_ENV=production

# Secret used to sign JWT cookies. REQUIRED in production — generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production

# LLM API keys — enable the AI tutor and AI submission feedback.
# First configured provider wins (order: Anthropic → OpenAI → Groq → OpenRouter → Gemini → Ollama).
# Without any key, submissions still run tests and the tutor returns a
# friendly "not configured" message. Several providers below have free tiers.
#
# Anthropic (recommended: claude-3-5-sonnet)
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI (uses gpt-4o-mini by default; override with OPENAI_MODEL=...)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# Groq — free tier: ~14,000 requests/day (fast inference)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
#
# OpenRouter — aggregates many providers; has permanently-free models
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
#
# Google Gemini — free tier: 15 RPM / 1M TPD (install: pip install google-generativeai)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash
#
# Ollama — 100% local, truly free, no API key. Run `ollama serve && ollama run llama3.2`
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# Google OAuth — enables the "Continue with Google" button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Where to send the browser after Google login completes.
# Dev: the Vite server. Production single-container: the app's own origin.
# FRONTEND_URL=http://localhost:5173

# SQLAlchemy database URL. Defaults to sqlite:///backend/app.db.
# The Docker image sets sqlite:////data/app.db (volume-backed).
# DATABASE_URL=

# Built-frontend directory served by the backend when it exists.
# Defaults to ../frontend/dist; the Docker image sets /srv/static.
# STATIC_DIR=

# ---------------------------------------------------------------- deployment
# Persistent database. Production MUST use either Postgres or SQLite on a
# mounted volume — a container's own filesystem is wiped on every redeploy.
# postgres:// and postgresql:// URLs are accepted as-is (Railway/Render style).
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Reverse proxies in front of the app that append to X-Forwarded-For.
# Railway alone = 1 (default). Vercel rewrite -> Railway = 2.
# TRUSTED_PROXY_HOPS=1

# Max submissions executing concurrently (each may use ~256 MB RAM).
# MAX_CONCURRENT_RUNS=2

# Anthropic model override (default claude-opus-5-5).
# ANTHROPIC_MODEL=
